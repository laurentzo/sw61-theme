{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,

  "settings": {

    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,

    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "base",      "color": "#F9F9F7", "name": "Base" },
        { "slug": "contrast",  "color": "#042D3A", "name": "Contrast" },
        { "slug": "accent-1",  "color": "#FF6F61", "name": "Accent 1 — Corail" },
        { "slug": "accent-2",  "color": "#A0F9CE", "name": "Accent 2 — Vert clair" },
        { "slug": "accent-4",  "color": "#5D967E", "name": "Accent 4 — Vert foncé" },
        { "slug": "primary",   "color": "#5D967E", "name": "Primary — Vert foncé" },
        { "slug": "secondary", "color": "#80D0AE", "name": "Secondary — Vert menthe" },
        { "slug": "blanc",     "color": "#FFFFFF", "name": "Blanc" },
        { "slug": "noir",      "color": "#000000", "name": "Noir" }
      ],
      "shadow": true
    },

    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "legere",
          "name": "Légère",
          "shadow": "1px 2px 3px 0px rgba(0,0,0,0.15)"
        }
      ]
    },

    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "writingMode": true,
      "fontFamilies": [
        {
          "slug": "dm-sans",
          "name": "DM Sans",
          "fontFamily": "'DM Sans', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/dm-sans/DMSans.woff2" ]
            },
            {
              "fontFamily": "DM Sans",
              "fontWeight": "100 900",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/dm-sans/DMSans-Italic.woff2" ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1.125rem",
          "fluid": { "min": "1rem", "max": "1.125rem" }
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.5rem",
          "fluid": { "min": "1.25rem", "max": "1.5rem" }
        },
        {
          "slug": "x-large",
          "name": "X-Large",
          "size": "2.125rem",
          "fluid": { "min": "1.6875rem", "max": "2.125rem" }
        },
        {
          "slug": "xx-large",
          "name": "XX-Large",
          "size": "2.375rem",
          "fluid": { "min": "1.875rem", "max": "2.375rem" }
        }
      ]
    },

    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "size": "10px",                    "name": "Tiny" },
        { "slug": "30", "size": "20px",                    "name": "X-Small" },
        { "slug": "40", "size": "30px",                    "name": "Small" },
        { "slug": "50", "size": "clamp(30px, 5vw, 50px)",  "name": "Regular" },
        { "slug": "60", "size": "clamp(30px, 7vw, 70px)",  "name": "Large" },
        { "slug": "70", "size": "clamp(50px, 7vw, 90px)",  "name": "X-Large" },
        { "slug": "80", "size": "clamp(70px, 10vw, 140px)","name": "XX-Large" },
        { "slug": "btn-mobile",         "size": "12px", "name": "Btn mobile" },
        { "slug": "btn-desk",           "size": "15px", "name": "Btn desktop" },
        { "slug": "text-mb",            "size": "20px", "name": "Text margin bottom" },
        { "slug": "container-y-mobile", "size": "15px", "name": "Container Y mobile" },
        { "slug": "container-x-mobile", "size": "30px", "name": "Container X mobile" },
        { "slug": "container-y-desk",   "size": "40px", "name": "Container Y desktop" },
        { "slug": "container-x-desk",   "size": "60px", "name": "Container X desktop" }
      ],
      "units": [ "%", "px", "em", "rem", "vh", "vw" ]
    },

    "layout": {
      "contentSize": "720px",
      "wideSize": "1140px"
    },

    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },

    "custom": {
      "font-weight": {
        "normal":   "400",
        "medium":   "500",
        "semibold": "600",
        "bold":     "700"
      },
      "tracking": {
        "titre": "-0.5px"
      },
      "radius": {
        "light":    "5px",
        "standard": "18px"
      },
      "trait": {
        "fin":      "1px",
        "standard": "2px"
      },
      "opacite": {
        "image": "0.6"
      },
      "dimension": {
        "puce-sm": "14px",
        "puce-md": "20px",
        "rs-sm":   "24px",
        "rs-md":   "32px",
        "rs-lg":   "48px"
      },
      "site": {
        "btn-min-h": "44px"
      }
    }

  },

  "styles": {

    "color": {
      "background": "var(--wp--preset--color--base)",
      "text":       "var(--wp--preset--color--contrast)"
    },

    "spacing": {
      "blockGap": "1.2rem",
      "padding": {
        "left":  "var(--wp--preset--spacing--50)",
        "right": "var(--wp--preset--spacing--50)"
      }
    },

    "typography": {
      "fontFamily":    "var(--wp--preset--font-family--dm-sans)",
      "fontSize":      "var(--wp--preset--font-size--medium)",
      "fontWeight":    "var(--wp--custom--font-weight--normal)",
      "letterSpacing": "-0.1px",
      "lineHeight":    "1.6"
    },

    "elements": {

      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--secondary)" }
        }
      },

      "button": {
        "color": {
          "background": "var(--wp--preset--color--contrast)",
          "text":       "var(--wp--preset--color--base)"
        },
        "typography": {
          "fontSize":   "var(--wp--preset--font-size--medium)",
          "fontWeight": "var(--wp--custom--font-weight--medium)"
        },
        "border": {
          "radius": "var(--wp--custom--radius--standard)"
        },
        "shadow": "var(--wp--preset--shadow--legere)",
        "spacing": {
          "padding": {
            "top":    "var(--wp--preset--spacing--btn-mobile)",
            "bottom": "var(--wp--preset--spacing--btn-mobile)",
            "left":   "var(--wp--preset--spacing--btn-desk)",
            "right":  "var(--wp--preset--spacing--btn-desk)"
          }
        }
      },

      "h1": {
        "typography": {
          "fontSize":      "var(--wp--preset--font-size--xx-large)",
          "fontWeight":    "var(--wp--custom--font-weight--bold)",
          "letterSpacing": "var(--wp--custom--tracking--titre)"
        }
      },
      "h2": {
        "typography": {
          "fontSize":      "var(--wp--preset--font-size--x-large)",
          "fontWeight":    "var(--wp--custom--font-weight--bold)",
          "letterSpacing": "var(--wp--custom--tracking--titre)"
        }
      },
      "h3": {
        "typography": {
          "fontSize":      "var(--wp--preset--font-size--x-large)",
          "fontWeight":    "var(--wp--custom--font-weight--semibold)",
          "letterSpacing": "var(--wp--custom--tracking--titre)"
        }
      },
      "h4": {
        "typography": {
          "fontSize":   "var(--wp--preset--font-size--large)",
          "fontWeight": "var(--wp--custom--font-weight--semibold)"
        }
      },
      "h5": {
        "typography": {
          "fontSize":   "var(--wp--preset--font-size--large)",
          "fontWeight": "var(--wp--custom--font-weight--medium)"
        }
      },
      "h6": {
        "typography": {
          "fontSize":   "var(--wp--preset--font-size--small)",
          "fontWeight": "var(--wp--custom--font-weight--medium)"
        }
      }

    }

  }
}
