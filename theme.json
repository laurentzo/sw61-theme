{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1140px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "sombre",
          "color": "#042D3A",
          "name": "Sombre"
        },
        {
          "slug": "vert-fonce",
          "color": "#5D967E",
          "name": "Vert foncé"
        },
        {
          "slug": "vert-menthe",
          "color": "#80D0AE",
          "name": "Vert menthe"
        },
        {
          "slug": "vert-clair",
          "color": "#A0F9CE",
          "name": "Vert clair"
        },
        {
          "slug": "corail",
          "color": "#FF6F61",
          "name": "Corail"
        },
        {
          "slug": "claire",
          "color": "#F9F9F7",
          "name": "Claire"
        },
        {
          "slug": "blanc",
          "color": "#FFFFFF",
          "name": "Blanc"
        },
        {
          "slug": "noir",
          "color": "#000000",
          "name": "Noir"
        }
      ],
      "duotone": []
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "dm-sans",
          "name": "DM Sans",
          "fontFamily": "DM Sans, sans-serif",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/dm-sans/DMSans.woff2"
              ]
            },
            {
              "fontFamily": "DM Sans",
              "fontWeight": "100 900",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/dm-sans/DMSans-Italic.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "clamp(14px, 1.4vw, 15px)"
        },
        {
          "slug": "body",
          "name": "Corps",
          "size": "18px"
        },
        {
          "slug": "btn",
          "name": "Bouton",
          "size": "clamp(17px, 1.7vw, 20px)"
        },
        {
          "slug": "h5",
          "name": "H5",
          "size": "clamp(15px, 2vw,   20px)"
        },
        {
          "slug": "h4",
          "name": "H4",
          "size": "clamp(20px, 2.4vw, 24px)"
        },
        {
          "slug": "h3",
          "name": "H3",
          "size": "clamp(24px, 3vw,   30px)"
        },
        {
          "slug": "h2",
          "name": "H2",
          "size": "clamp(27px, 3.4vw, 34px)"
        },
        {
          "slug": "h1",
          "name": "H1",
          "size": "clamp(30px, 3.8vw, 38px)"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": [
        "px",
        "rem",
        "%"
      ],
      "spacingSizes": [
        {
          "slug": "btn-mobile",
          "name": "Btn mobile",
          "size": "12px"
        },
        {
          "slug": "btn-desk",
          "name": "Btn desktop",
          "size": "15px"
        },
        {
          "slug": "text-mb",
          "name": "Texte margin-b",
          "size": "20px"
        },
        {
          "slug": "container-y-mobile",
          "name": "Container Y mobile",
          "size": "15px"
        },
        {
          "slug": "container-x-mobile",
          "name": "Container X mobile",
          "size": "30px"
        },
        {
          "slug": "container-y-desk",
          "name": "Container Y desk",
          "size": "40px"
        },
        {
          "slug": "container-x-desk",
          "name": "Container X desk",
          "size": "60px"
        }
      ],
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "border": {
      "radius": true,
      "width": true,
      "color": true,
      "style": true,
      "defaultRadius": false
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "legere",
          "name": "Légère",
          "shadow": "1px 2px 3px 0px rgba(0,0,0,0.15)"
        }
      ]
    },
    "custom": {
      "radius": {
        "light": "5px",
        "standard": "18px"
      },
      "border": {
        "standard": "2px",
        "fin": "1px"
      },
      "tracking": {
        "titre": "-0.5px"
      },
      "opacity": {
        "image": "0.6"
      },
      "sizing": {
        "btn-min-h": "44px",
        "puce-sm": "14px",
        "puce-md": "20px",
        "rs-sm": "24px",
        "rs-md": "32px",
        "rs-lg": "48px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--claire)",
      "text": "var(--wp--preset--color--sombre)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--dm-sans)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "fontWeight": "400",
      "lineHeight": "1.6"
    },
    "spacing": {
      "padding": {
        "top": "0px",
        "bottom": "0px",
        "left": "var(--wp--preset--spacing--container-x-mobile)",
        "right": "var(--wp--preset--spacing--container-x-mobile)"
      }
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-sans)",
          "fontSize": "var(--wp--preset--font-size--h1)",
          "fontWeight": "700",
          "letterSpacing": "var(--wp--custom--tracking--titre)",
          "lineHeight": "1.15"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-sans)",
          "fontSize": "var(--wp--preset--font-size--h2)",
          "fontWeight": "700",
          "letterSpacing": "var(--wp--custom--tracking--titre)",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-sans)",
          "fontSize": "var(--wp--preset--font-size--h3)",
          "fontWeight": "600",
          "letterSpacing": "var(--wp--custom--tracking--titre)",
          "lineHeight": "1.25"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-sans)",
          "fontSize": "var(--wp--preset--font-size--h4)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-sans)",
          "fontSize": "var(--wp--preset--font-size--h5)",
          "fontWeight": "500",
          "lineHeight": "1.35"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-sans)",
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "500",
          "lineHeight": "1.4"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--vert-fonce)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--vert-menthe)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--sombre)",
          "text": "var(--wp--preset--color--blanc)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-sans)",
          "fontSize": "var(--wp--preset--font-size--btn)",
          "fontWeight": "500"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--btn-mobile)",
            "bottom": "var(--wp--preset--spacing--btn-mobile)",
            "left": "var(--wp--preset--spacing--container-x-mobile)",
            "right": "var(--wp--preset--spacing--container-x-mobile)"
          }
        },
        "border": {
          "radius": "var(--wp--custom--radius--standard)"
        },
        "shadow": "var(--wp--preset--shadow--legere)",
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--vert-fonce)",
            "text": "var(--wp--preset--color--blanc)"
          }
        }
      }
    },
    "blocks": {
      "core/image": {
        "filter": {
          "duotone": "unset"
        },
        "css": ".wp-block-image img { opacity: var(--wp--custom--opacity--image); }"
      },
      "core/group": {
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--container-y-mobile)",
            "bottom": "var(--wp--preset--spacing--container-y-mobile)"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "En-tête",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pied de page",
      "area": "footer"
    }
  ]
}